{
  "name": "Trading Copilot",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/AI-Trading-Investing-agent",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "8000": { "label": "FastAPI API", "onAutoForward": "notify", "visibility": "private" },
    "5173": { "label": "Trading Copilot", "onAutoForward": "openBrowser", "visibility": "private" }
  },
  "postCreateCommand": "python -m pip install -r backend/requirements.txt && cd frontend && npm install"
}
