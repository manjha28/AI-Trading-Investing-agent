# Copy to .env (git-ignored) and replace every placeholder. Never commit .env.
# Generate KAFKA_CLUSTER_ID with: docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid

KAFKA_CLUSTER_ID=replace-with-generated-uuid
KAFKA_HEAP_OPTS=-Xms512m -Xmx768m
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_DEV_PORT=9092

VALKEY_PASSWORD=replace-with-strong-password
VALKEY_MAXMEMORY=256mb
VALKEY_DEV_PORT=6379

POSTGRES_DB=trading_copilot
POSTGRES_USER=trading_copilot
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DEV_PORT=5432
