# BACKEND_HOST is set in frontend.fly.toml (the backend app's private .internal address).
server {
  listen 8080;
  root /usr/share/nginx/html;
  resolver [fdaa::3] valid=10s ipv6=on;   # Fly's private DNS; resolved per request so nginx starts even before the API app exists
  location /api/ {
    # The API app is reached through its public Fly hostname: Fly's edge connects to an IPv4 listener, and the app
    # binds 0.0.0.0 (a 6PN .internal address would need an IPv6 bind, which the edge cannot use).
    set $backend_host ${BACKEND_HOST};
    proxy_pass https://$backend_host;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host ${BACKEND_HOST};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }
  location / { try_files $uri /index.html; }
}
