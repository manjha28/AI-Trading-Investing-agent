# BACKEND_HOST is set in frontend.fly.toml (the backend app's private .internal address).
server {
  listen 8080;
  root /usr/share/nginx/html;
  resolver [fdaa::3] valid=10s ipv6=on;   # Fly's private DNS; resolved per request so nginx starts even before the API app exists
  location /api/ {
    set $backend http://${BACKEND_HOST}:8080;
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }
  location / { try_files $uri /index.html; }
}
